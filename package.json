{
  "name": "martyrs-platform-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --ui=stream",
    "dev:orchestrator": "npm run dev --workspace=@martyrs/orchestrator",
    "dev:learner": "npm run dev --workspace=@martyrs/learner",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.2"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
