    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@apollo/client-integration-tanstack-start": "0.14.5-rc.0",
