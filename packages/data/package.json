    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "graphql": "^16.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "eslint": "^10",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
