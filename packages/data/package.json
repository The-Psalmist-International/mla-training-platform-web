{
  "name": "@workspace/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./apollo/*/query": "./apollo/*/query.ts"
  },
  "scripts": {
    "codegen": "graphql-codegen --config ../../codegen.ts",
    "codegen:check": "graphql-codegen --config ../../codegen.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"!src/generated/**\" \"apollo/**/*.{ts,graphql}\""
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@apollo/client-integration-tanstack-start": "0.14.5-rc.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "graphql": "^16.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@tanstack/eslint-config": "latest",
    "eslint": "^10",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
  }
}
